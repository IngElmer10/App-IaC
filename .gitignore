# Terraform working directories, state, plans, and crash logs
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Terraform variable files may contain secrets
*.tfvars
*.tfvars.json
!*.tfvars.example

# Credenciales y configuración local
.env
.env.*
!.env.example
*.pem
*.key

# Dependencias
node_modules/
