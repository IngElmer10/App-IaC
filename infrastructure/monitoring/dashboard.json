{
  "uid": "attendance-tenant", "title": "Tenant · Salud y rendimiento", "schemaVersion": 39, "version": 1,
  "refresh": "10s", "time": {"from": "now-30m", "to": "now"}, "tags": ["attendance", "tenant"],
  "panels": [
    {"id":1,"type":"stat","title":"Backend disponible","gridPos":{"x":0,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"up{job=\"attendance\"}","refId":"A"}]},
    {"id":2,"type":"stat","title":"PostgreSQL disponible","gridPos":{"x":6,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"attendance_database_up","refId":"A"}]},
    {"id":3,"type":"stat","title":"Alertas activas","gridPos":{"x":12,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"count(ALERTS{alertstate=\"firing\"}) or vector(0)","refId":"A"}]},
    {"id":4,"type":"stat","title":"Estudiantes activos","gridPos":{"x":18,"y":0,"w":6,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"attendance_students","refId":"A"}]},
    {"id":5,"type":"timeseries","title":"CPU por instancia (%)","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (1 - avg by (role) (rate(node_cpu_seconds_total{mode=\"idle\",role=~\"frontend|backend|database\"}[2m])))","legendFormat":"{{role}}","refId":"A"}]},
    {"id":6,"type":"timeseries","title":"Memoria por instancia (%)","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)","legendFormat":"{{role}}","refId":"A"}]},
    {"id":7,"type":"timeseries","title":"Latencia media del backend (segundos)","gridPos":{"x":0,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(attendance_http_duration_seconds_sum[2m]) / clamp_min(rate(attendance_http_duration_seconds_count[2m]), 0.001)","refId":"A"}]},
    {"id":8,"type":"timeseries","title":"Errores del backend por segundo","gridPos":{"x":12,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(attendance_http_errors_total[2m])","refId":"A"}]},
    {"id":9,"type":"stat","title":"Instancias monitoreadas (esperado: 3)","gridPos":{"x":0,"y":21,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(up{job=\"node\",role=~\"frontend|backend|database\"})","refId":"A"}]},
    {"id":10,"type":"stat","title":"Salud de cada instancia","gridPos":{"x":8,"y":21,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"up{job=\"node\",role=~\"frontend|backend|database\"}","legendFormat":"{{role}}","refId":"A"}]},
    {"id":11,"type":"stat","title":"PostgreSQL dedicado","gridPos":{"x":16,"y":21,"w":8,"h":5},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"pg_up","refId":"A"}]}
  ]
}
